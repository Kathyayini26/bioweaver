# BioWeaver Environment Configuration Example

# Backend Environment Variables
# PORT is automatically injected by cloud providers like Render (default: 8000)
PORT=8000

# FRONTEND_URL: Allowed production frontend origin for CORS
# Set to your deployed Vercel / Render frontend URL in production
FRONTEND_URL=http://localhost:5173

# Optional: Path overrides for model & graph artifacts if stored in a custom directory
# MODEL_PATH=data/processed/random_forest_model.pkl
# EMBEDDINGS_PATH=data/processed/node_embeddings.csv
# GRAPH_PATH=data/processed/bioweaver_graph.pkl

# Frontend Environment Variables (Set in Vercel/Render Frontend settings)
VITE_API_URL=http://localhost:8000
